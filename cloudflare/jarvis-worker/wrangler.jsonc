{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis-whatsapp-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "POLL_STATE",
      "id": "7d7c355d35ee44a3b464e349e6b7159c"
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "vars": {
    "AGENT_URL": "https://z-agent-zeta.vercel.app"
  }
}
