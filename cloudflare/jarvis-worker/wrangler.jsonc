{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "z-agent",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "POLL_STATE",
      "id": "7d7c355d35ee44a3b464e349e6b7159c"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // Worker Previews need an explicit previews block; keep preview-specific settings empty.
  "previews": {},
  // Public, non-sensitive configuration only. Keep DASHBOARD_TOKEN and CRON_SECRET as Cloudflare Secrets.
  "vars": {
    "AGENT_URL": "https://z-agent-zeta.vercel.app"
  }
}
